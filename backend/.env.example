# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Connection
MONGO_URL=mongodb://admin:password@mongodb:27017/luxee?authSource=admin

# JWT Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# AI Provider Switch (deepseek=nvidia|deepseek) — см. корневой .env
AI_PROVIDER=nvidia
AI_API_URL=https://api.deepseek.com
AI_API_KEY=your_deepseek_api_key_here
AI_MODEL=deepseek-v4-flash
NVIDIA_API_KEY=your_nvidia_api_key_here
# NVIDIA_API_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# OpenAI Configuration (deprecated, оставлен для совместимости)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Browser Configuration (опционально)
# BROWSER_HEADLESS=true  # Принудительно включить headless режим (автоматически в production)
# BROWSER_SLOW_MO=0      # Замедление действий браузера в мс (0 = без замедления)
# BROWSER_DEVTOOLS=false # Открывать DevTools

# Spambot Service Configuration
# For Docker: http://backend-spambot:8001
# For local dev: http://localhost:8001
SPAMBOT_SERVICE_URL=http://localhost:8001
